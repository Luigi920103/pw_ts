{
  "name": "pw_ts_automation",
  "version": "1.0.0",
  "description": "Framework de automatización Playwright con TypeScript",
  "main": "index.js",
  "scripts": {
    "test-all": "npx playwright test --workers=2 --config=./playwright.config.ts --project=chrome-parallel --grep @all",
    "test:ui": "npx playwright test --config=playwright.config.ts --project=chrome",
    "test:api": "npx playwright test --config=playwright.config.ts --project=api",
    "uiDebug": "cross-env API_DEBUG=true npx playwright test --workers=2 --config=playwright.config.ts --project=chrome --grep @uiDebug",
    "apiDebug": "cross-env API_DEBUG=true npx playwright test --workers=2 --config=playwright.config.ts --project=api --grep @api",
    "allure:clean": "rimraf allure-results allure-report",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "allure-js-commons": "^3.4.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "joi": "^18.0.2",
    "mongodb": "^7.0.0",
    "pg": "^8.17.2",
    "uuid": "^9.0.1"
  }
}
